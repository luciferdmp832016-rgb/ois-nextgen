# OIS NextGen environment template.
# Keep real values in local shells, Codex Cloud secrets, GitHub secrets or Abacus secrets.
# Never commit production credentials.

APP_NAME="OIS NextGen"
APP_ENV="local"
APP_VERSION="0.1.0"
GIT_COMMIT="local"
DEPLOY_TARGET="local"
LOCALHOST_REQUIRED="false"
TZ="Asia/Ho_Chi_Minh"

# Public service URLs
PUBLIC_APP_URL="http://localhost:3000"
OIS_CONSOLE_URL="http://localhost:3000"
PITS_SHELL_URL="http://localhost:3001"
CORE_API_URL="http://localhost:4000"

# Runtime ports and hosts
CORE_API_HOST="::"
CORE_API_PORT=4000
OIS_CONSOLE_PORT=3000
PITS_SHELL_PORT=3001

# Database
DATABASE_PROVIDER="postgres"
DATABASE_URL="postgresql://ois_nextgen:change-me@localhost:5432/ois_nextgen?schema=public"
MIGRATION_MODE="deploy"

# Auth and session placeholders
JWT_SECRET="replace-with-environment-secret"
SESSION_SECRET="replace-with-environment-secret"

# Storage placeholders. Stage 0D documents readiness only; runtime storage stays inactive.
STORAGE_PROVIDER="mock"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Abacus placeholders. Do not use production values in Codex, CI or local tests.
ABACUS_ENV="disabled"
ABACUS_APP_ID=""
ABACUS_PUBLIC_APP_URL=""
ABACUS_DATABASE_URL=""
ABACUS_STORAGE_BUCKET=""
ABACUS_STORAGE_ENDPOINT=""
ABACUS_STORAGE_ACCESS_KEY=""
ABACUS_STORAGE_SECRET_KEY=""

# AI gateway placeholders. Stage 0D does not activate AI runtime calls.
AI_PROVIDER="mock"
AI_PROVIDER_MODE="mock"
OPENROUTER_API_KEY=""
AI_DEFAULT_MODEL=""
AI_EXTRACT_MODEL=""
AI_REASONING_MODEL=""
AI_FALLBACK_MODEL=""
AI_DAILY_BUDGET_USD=0
AI_ENABLE_CACHE="true"
AI_ENABLE_TELEMETRY="true"
AI_REQUEST_TIMEOUT_MS=45000

# Observability and health
LOG_LEVEL="info"
ENABLE_AUDIT_LOG="true"
ENABLE_DEPLOYMENT_HEALTH="true"
SENTRY_DSN=""
