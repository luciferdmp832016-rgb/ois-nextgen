generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LifecycleStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  DEPRECATED
  ARCHIVED
  PLANNED
  BLOCKED_BY_PHASE2
  BLOCKED_BY_PHASE3
}

enum ScopeKind {
  PLATFORM
  INDUSTRY
  ORGANIZATION
  WORKSPACE
  PROJECT
  PRODUCT_INSTALLATION
}

enum ProductCode {
  OIS
  PITS
  CS_AGENT
  KEIHB
  ICR
}

enum IdentityRealmCode {
  OIS_ORGANIZATION_USER
  PITS_PROJECT_USER
  CSAGENT_RESIDENT
  EXTERNAL_PARTNER
  SYSTEM_SERVICE
}

enum ModuleType {
  PLATFORM_KERNEL
  CONTROL_PLANE_VIEW
  PRODUCT_RUNTIME_VIEW
  DOMAIN_SERVICE
  REPOSITORY
  WORKER
}

enum OisEcosystemProductType {
  CORE_PLATFORM
  ECOSYSTEM_PRODUCT
  MEETING_INTELLIGENCE_PRODUCT
  FUTURE_PRODUCT
  CUSTOM_PRODUCT
}

enum OisLearningScope {
  ORGANIZATION
  INDUSTRY
  PLATFORM
}

enum OisSourceAuthority {
  CEO
  CHAIRMAN
  BOD
  C_LEVEL
  DIRECTOR
  MANAGER
  SUPERADMIN
  ADMIN
  STAFF
  END_USER
  SYSTEM
  UNKNOWN
}

enum OisLearningPolicyMode {
  ALWAYS_ASK
  AUTO_IF_CONFIDENCE
  FULL_AUTO_PILOT
  LOG_ONLY
}

enum OisLearningSourceType {
  WIDGET
  MEETING
  DOCUMENT
  TICKET
  CHAT
  EMAIL
  CALL
  SYSTEM
  IMPORT
  OTHER
}

enum OisLearningSignalType {
  USER_CORRECTION
  NEW_KNOWLEDGE
  EXECUTIVE_STATEMENT
  CEO_DIRECTIVE
  STRATEGIC_INTENT
  SOP_CORRECTION
  FAQ_CORRECTION
  ENTITY_CORRECTION
  RISK_PATTERN
  TICKET_PATTERN
  CANDIDATE_MARKET_SIGNAL
  CUSTOMER_COMPLAINT_PATTERN
  PRODUCT_FEEDBACK
  KNOWLEDGE_GAP
  OTHER
}

enum OisLearningSignalStatus {
  RECEIVED
  TRIAGED
  CANDIDATE_CREATED
  IGNORED
  ERROR
}

enum OisLearningCandidateType {
  EXECUTIVE_DIRECTIVE
  STRATEGIC_PRIORITY
  MANAGEMENT_PRINCIPLE
  EXECUTIVE_CONCERN
  MISALIGNMENT_SIGNAL
  ENTITY_UPDATE
  SOP_UPDATE
  FAQ_UPDATE
  RISK_PATTERN
  TICKET_PATTERN
  PRODUCT_IMPROVEMENT
  INDUSTRY_PATTERN
  PLATFORM_PATTERN
  OTHER
}

enum OisLearningConflictStatus {
  NO_CONFLICT
  POSSIBLE_CONFLICT
  CONFLICT
  INSUFFICIENT_EVIDENCE
}

enum OisLearningPolicyDecision {
  ASK_REVIEW
  AUTO_LEARN
  LOG_ONLY
  BLOCKED
}

enum OisLearningCandidateStatus {
  PENDING_REVIEW
  AUTO_LEARNED
  APPROVED
  REJECTED
  PROMOTED
  ROLLED_BACK
}

enum OisAgentSessionStatus {
  OPEN
  CLOSED
}

enum OisAgentMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum OisAgentFeedbackType {
  HELPFUL
  NOT_HELPFUL
  WRONG_ANSWER
  CORRECTION
  CONFIRMED_TRUE
  ESCALATED
}

enum OisKnowledgeLayerKey {
  KL_0_LEGAL_REGULATORY_CORE
  KL_1_INDUSTRY_CORE
  KL_2_ORGANIZATION_CORE
  KL_3_PRODUCT_KNOWLEDGE_PACK
  KL_4_WORKSPACE_PROJECT_OVERLAY
  KL_5_LIVE_OPERATIONAL_SIGNALS
}

enum OisKnowledgeItemType {
  FACT
  POLICY
  SOP
  FAQ
  PLAYBOOK
  CHECKLIST
  EXECUTIVE_INTENT
  DECISION_RULE
  RISK_PATTERN
  INDUSTRY_PATTERN
  PRODUCT_RULE
  WORKSPACE_OVERLAY
  LIVE_SIGNAL_SUMMARY
  OTHER
}

enum OisKnowledgeItemStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum OisSensitivityLevel {
  LOW
  MEDIUM
  HIGH
  RESTRICTED
}

enum OisKnowledgePromotionAction {
  CREATE
  UPDATE
  DEPRECATE
  MERGE
  LINK_ONLY
  LOG_ONLY
}

enum OisKnowledgeLayerMappingStatus {
  DRAFT_MAPPING
  READY_FOR_REVIEW
  APPROVED_FOR_FUTURE_PROMOTION
  REJECTED
  BLOCKED
}

enum OisKnowledgeProjectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OimaMeetingSourceMode {
  TRANSCRIPT_ONLY
  AUDIO_ONLY
  TRANSCRIPT_AND_AUDIO
  LISTENER_CAPTURED
}

enum OimaMeetingStatus {
  DRAFT
  UPLOADED
  READY_FOR_PROCESSING
  NEEDS_REVIEW
  FAILED
}

enum OimaMeetingSourceFileType {
  TRANSCRIPT
  AUDIO
  PARTICIPANT_LIST
  OTHER
}

enum OimaMeetingSourceUploadStatus {
  REGISTERED
  UPLOADED
  FAILED
}

enum OimaTranscriptVersionType {
  RAW
  NORMALIZED
  CORRECTED
}

enum OimaTranscriptParserType {
  MICROSOFT_TEAMS
  GENERIC_TEXT
  MANUAL
}

enum OimaTranscriptParseRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  NEEDS_REVIEW
  FAILED
}

enum OimaTranscriptParseWarningSeverity {
  INFO
  WARNING
  ERROR
}

model Industry {
  id            String          @id
  code          String          @unique
  name          String
  lifecycle     LifecycleStatus @default(ACTIVE)
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  organizations Organization[]
}

model Organization {
  id             String          @id
  code           String          @unique
  name           String
  industryId     String
  lifecycle      LifecycleStatus @default(ACTIVE)
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  industry       Industry        @relation(fields: [industryId], references: [id], onDelete: Restrict)
  workspaces     Workspace[]
  memberships    WorkspaceMembership[]
  installations  ProductInstallation[]
  roles          RoleDefinition[]
  config         EffectiveConfigurationSnapshot[]
  featureFlags   FeatureFlag[]
  auditRecords   AuditRecord[]
  legacyMappings LegacyIdentityMap[]
  oimaMeetings   OimaMeetingRecord[]

  @@index([industryId])
}

model Workspace {
  id             String          @id
  code           String
  name           String
  organizationId String
  lifecycle      LifecycleStatus @default(ACTIVE)
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projects       Project[]
  memberships    WorkspaceMembership[]
  installations  ProductInstallation[]
  config         EffectiveConfigurationSnapshot[]
  featureFlags   FeatureFlag[]
  auditRecords   AuditRecord[]
  legacyMappings LegacyIdentityMap[]
  oimaMeetings   OimaMeetingRecord[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Project {
  id             String          @id
  code           String
  name           String
  workspaceId    String
  lifecycle      LifecycleStatus @default(ACTIVE)
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  installations  ProductInstallation[]
  config         EffectiveConfigurationSnapshot[]
  featureFlags   FeatureFlag[]
  auditRecords   AuditRecord[]
  legacyMappings LegacyIdentityMap[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model UserAccount {
  id              String            @id
  email           String            @unique
  displayName     String
  realmCode       IdentityRealmCode
  lifecycle       LifecycleStatus   @default(ACTIVE)
  demoOnly        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  memberships     WorkspaceMembership[]
  auditRecords    AuditRecord[]
}

model WorkspaceMembership {
  id             String          @id
  organizationId String
  workspaceId    String
  userId         String
  roleCode       String
  lifecycle      LifecycleStatus @default(ACTIVE)
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user           UserAccount     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, userId, roleCode])
  @@index([organizationId, workspaceId])
  @@index([userId])
}

model ProductDefinition {
  id             String          @id
  code           ProductCode     @unique
  name           String
  lifecycle      LifecycleStatus @default(ACTIVE)
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  installations  ProductInstallation[]
  modules        ModuleDefinition[]
  roles          RoleDefinition[]
  permissions    PermissionDefinition[]
}

model OisEcosystemProduct {
  id                           String                  @id
  productKey                   String                  @unique
  displayName                  String
  description                  String
  productType                  OisEcosystemProductType
  enabled                      Boolean                 @default(true)
  supportedAgentCapabilities   String[]
  supportedLearningSignalTypes String[]
  defaultLearningScope         OisLearningScope
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
}

model OisLearningPolicy {
  id                  String                @id
  organizationId      String
  productKey          String
  learningScope       OisLearningScope
  signalType          OisLearningSignalType
  sourceAuthority     OisSourceAuthority
  policyMode          OisLearningPolicyMode
  confidenceThreshold Float                 @default(0.95)
  enabled             Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([organizationId, productKey, learningScope, signalType, sourceAuthority])
  @@index([organizationId, productKey, learningScope])
}

model OisLearningSignal {
  id                String                  @id
  organizationId    String
  workspaceId       String?
  productKey        String
  sourceType        OisLearningSourceType
  sourceAuthority   OisSourceAuthority
  learningScope     OisLearningScope
  signalType        OisLearningSignalType
  rawText           String
  normalizedText    String
  contextJson       Json                    @default("{}")
  relatedEntityRefs Json                    @default("[]")
  submittedBy       String?
  userId            String?
  confidenceInitial Float                   @default(0)
  status            OisLearningSignalStatus @default(RECEIVED)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([organizationId, workspaceId, createdAt])
  @@index([productKey, signalType, sourceAuthority])
  @@index([status, createdAt])
}

model OisLearningCandidate {
  id                      String                     @id
  signalId                String
  organizationId          String
  workspaceId             String?
  productKey              String
  learningScope           OisLearningScope
  candidateType           OisLearningCandidateType
  title                   String
  summary                 String
  proposedKnowledgeJson   Json                       @default("{}")
  affectedProducts        String[]
  affectedEntities        Json                       @default("[]")
  sourceAuthority         OisSourceAuthority
  confidenceScore         Float                      @default(0)
  confidenceBreakdownJson Json                       @default("{}")
  conflictStatus          OisLearningConflictStatus  @default(NO_CONFLICT)
  policyDecision          OisLearningPolicyDecision  @default(ASK_REVIEW)
  status                  OisLearningCandidateStatus @default(PENDING_REVIEW)
  evidenceJson            Json                       @default("{}")
  reviewerId              String?
  reviewedAt              DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([signalId])
  @@index([organizationId, workspaceId, createdAt])
  @@index([productKey, candidateType, status])
  @@index([sourceAuthority, policyDecision])
}

model OisAgentSession {
  id                    String                @id
  organizationId        String
  workspaceId           String?
  productKey            String
  currentRoute          String?
  screen                String?
  currentEntityRefs     Json                  @default("[]")
  userRole              String?
  permissionContextJson Json                  @default("{}")
  locale                String?
  status                OisAgentSessionStatus @default(OPEN)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([organizationId, workspaceId, productKey])
  @@index([status, createdAt])
}

model OisAgentMessage {
  id           String              @id
  sessionId    String
  role         OisAgentMessageRole
  content      String
  evidenceJson Json                @default("{}")
  createdAt    DateTime            @default(now())

  @@index([sessionId, createdAt])
}

model OisAgentFeedback {
  id             String               @id
  organizationId String
  workspaceId    String?
  productKey     String
  sessionId      String
  messageId      String?
  feedbackType   OisAgentFeedbackType
  comment        String?
  submittedBy    String?
  userId         String?
  createdAt      DateTime             @default(now())

  @@index([organizationId, workspaceId, productKey])
  @@index([sessionId, messageId])
}

model OisAgentLearningSubmission {
  id             String                  @id
  organizationId String
  workspaceId    String?
  productKey     String
  sessionId      String?
  signalId       String?
  sourceAuthority OisSourceAuthority
  learningScope  OisLearningScope
  signalType     OisLearningSignalType
  rawText        String
  status         OisLearningSignalStatus @default(RECEIVED)
  submittedBy    String?
  userId         String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId, workspaceId, productKey])
  @@index([signalId])
  @@index([sessionId])
}

model OisCanonicalKnowledgeItem {
  id                     String                 @id
  layerKey               OisKnowledgeLayerKey
  scope                  OisLearningScope
  itemType               OisKnowledgeItemType
  title                  String
  summary                String
  contentJson            Json                   @default("{}")
  status                 OisKnowledgeItemStatus @default(DRAFT)
  version                Int                    @default(1)
  locale                 String                 @default("en")
  organizationId         String?
  workspaceId            String?
  industryCode           String?
  productKey             String?
  entityRefs             Json                   @default("[]")
  relatedEntityIds       String[]
  sensitivityLevel       OisSensitivityLevel    @default(LOW)
  confidenceScore        Float                  @default(0)
  sourceAuthority        OisSourceAuthority
  createdFromCandidateId String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([layerKey, scope, status])
  @@index([organizationId, workspaceId, productKey])
  @@index([industryCode, productKey])
  @@index([createdFromCandidateId])
}

model OisKnowledgeEvidenceLink {
  id                  String                @id
  knowledgeItemId     String?
  learningCandidateId String?
  sourceType          OisLearningSourceType
  sourceRef           String
  sourceTitle         String
  excerpt             String
  excerptHash         String
  evidenceWeight      Float                 @default(0.5)
  sourceAuthority     OisSourceAuthority
  createdAt           DateTime              @default(now())

  @@index([knowledgeItemId])
  @@index([learningCandidateId])
  @@index([sourceType, sourceAuthority])
}

model OisKnowledgeLayerMapping {
  id                  String                         @id
  learningCandidateId String
  targetLayerKey      OisKnowledgeLayerKey
  targetItemType      OisKnowledgeItemType
  proposedAction      OisKnowledgePromotionAction
  proposedTitle       String
  proposedSummary     String
  proposedContentJson Json                           @default("{}")
  affectedProducts    String[]
  affectedEntities    Json                           @default("[]")
  confidenceScore     Float                          @default(0)
  policyDecision      OisLearningPolicyDecision
  status              OisKnowledgeLayerMappingStatus @default(DRAFT_MAPPING)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  @@unique([learningCandidateId, targetLayerKey, targetItemType, proposedAction])
  @@index([learningCandidateId])
  @@index([targetLayerKey, targetItemType, status])
  @@index([policyDecision, status])
}

model OisKnowledgeProjectionBundle {
  id                String                       @id
  bundleKey         String                       @unique
  displayName       String
  productKey        String
  targetAudience    String
  role              String
  locale            String                       @default("en")
  includedLayerKeys String[]
  includedItemIds   String[]
  selectionRules    Json                         @default("{}")
  snapshotVersion   Int                          @default(1)
  status            OisKnowledgeProjectionStatus @default(DRAFT)
  manifestJson      Json                         @default("{}")
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([productKey, status])
  @@index([locale, role])
}

model OimaMeetingRecord {
  id               String                 @id
  organizationId   String
  workspaceId      String
  title            String
  meetingDate      DateTime
  startTime        String?
  endTime          String?
  sourceMode       OimaMeetingSourceMode
  participantCount Int                    @default(0)
  status           OimaMeetingStatus      @default(DRAFT)
  confidenceScore  Float                  @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sourceFiles      OimaMeetingSourceFile[]
  transcriptVersions OimaTranscriptVersion[]
  transcriptParseRuns OimaTranscriptParseRun[]
  transcriptSegments OimaTranscriptSegment[]

  @@index([organizationId, workspaceId, meetingDate])
  @@index([workspaceId, status, createdAt])
  @@index([sourceMode, status])
}

model OimaMeetingSourceFile {
  id               String                        @id
  meetingId        String
  fileType         OimaMeetingSourceFileType
  originalFilename String
  storageKey       String?
  storageUrl       String?
  mimeType         String?
  sizeBytes        Int                           @default(0)
  checksum         String?
  uploadStatus     OimaMeetingSourceUploadStatus @default(REGISTERED)
  createdAt        DateTime                      @default(now())
  meeting          OimaMeetingRecord             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  transcriptVersions OimaTranscriptVersion[]
  transcriptParseRuns OimaTranscriptParseRun[]

  @@index([meetingId, fileType])
  @@index([uploadStatus, createdAt])
}

model OimaTranscriptVersion {
  id             String                    @id
  meetingId      String
  sourceFileId   String
  versionType    OimaTranscriptVersionType
  versionNumber  Int
  rawContentHash String
  contentStorageKey String?
  contentText    String?
  isImmutable    Boolean                   @default(false)
  createdBy      String?
  createdAt      DateTime                  @default(now())
  meeting        OimaMeetingRecord         @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  sourceFile     OimaMeetingSourceFile     @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)
  parseRunsAsRaw OimaTranscriptParseRun[]  @relation("OimaRawTranscriptVersion")
  parseRunsAsNormalized OimaTranscriptParseRun[] @relation("OimaNormalizedTranscriptVersion")
  segments       OimaTranscriptSegment[]

  @@unique([meetingId, versionType, versionNumber])
  @@index([meetingId, sourceFileId, versionType])
  @@index([rawContentHash])
}

model OimaTranscriptParseRun {
  id                  String                         @id
  meetingId           String
  sourceFileId        String
  rawVersionId        String
  normalizedVersionId String
  parserType          OimaTranscriptParserType
  status              OimaTranscriptParseRunStatus   @default(PENDING)
  segmentCount        Int                            @default(0)
  warningCount        Int                            @default(0)
  confidenceScore     Float                          @default(0)
  startedAt           DateTime                       @default(now())
  completedAt         DateTime?
  errorMessage        String?
  meeting             OimaMeetingRecord              @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  sourceFile          OimaMeetingSourceFile          @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)
  rawVersion          OimaTranscriptVersion          @relation("OimaRawTranscriptVersion", fields: [rawVersionId], references: [id], onDelete: Restrict)
  normalizedVersion   OimaTranscriptVersion          @relation("OimaNormalizedTranscriptVersion", fields: [normalizedVersionId], references: [id], onDelete: Restrict)
  segments            OimaTranscriptSegment[]
  warnings            OimaTranscriptParseWarning[]

  @@index([meetingId, status, startedAt])
  @@index([sourceFileId, parserType])
  @@index([rawVersionId])
  @@index([normalizedVersionId])
}

model OimaTranscriptSegment {
  id                  String                   @id
  meetingId           String
  transcriptVersionId String
  parseRunId          String
  segmentIndex        Int
  sourceLineStart     Int
  sourceLineEnd       Int
  timestampStart      String?
  timestampEnd        String?
  speakerRaw          String?
  speakerNormalized   String?
  rawText             String
  normalizedText      String
  confidenceScore     Float                    @default(0)
  needsReview         Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  meeting             OimaMeetingRecord        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  transcriptVersion   OimaTranscriptVersion    @relation(fields: [transcriptVersionId], references: [id], onDelete: Restrict)
  parseRun            OimaTranscriptParseRun   @relation(fields: [parseRunId], references: [id], onDelete: Cascade)
  warnings            OimaTranscriptParseWarning[]

  @@unique([parseRunId, segmentIndex])
  @@index([meetingId, segmentIndex])
  @@index([transcriptVersionId, segmentIndex])
  @@index([needsReview])
}

model OimaTranscriptParseWarning {
  id          String                            @id
  parseRunId  String
  segmentId   String?
  warningType String
  message     String
  severity    OimaTranscriptParseWarningSeverity @default(WARNING)
  createdAt   DateTime                         @default(now())
  parseRun    OimaTranscriptParseRun           @relation(fields: [parseRunId], references: [id], onDelete: Cascade)
  segment     OimaTranscriptSegment?           @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([parseRunId, severity])
  @@index([segmentId])
}

model ProductInstallation {
  id             String          @id
  productCode    ProductCode
  productId      String
  organizationId String
  workspaceId    String
  projectId      String
  lifecycle      LifecycleStatus @default(ACTIVE)
  configuration  Json            @default("{}")
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  product        ProductDefinition @relation(fields: [productId], references: [id], onDelete: Restrict)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  grants         ProductCapabilityGrant[]
  config         EffectiveConfigurationSnapshot[]
  featureFlags   FeatureFlag[]
  auditRecords   AuditRecord[]

  @@unique([projectId, productCode])
  @@index([organizationId, workspaceId, projectId])
  @@index([productId])
}

model ProductCapabilityGrant {
  id                    String          @id
  productInstallationId String
  capabilityCode        String
  enabled               Boolean         @default(true)
  lifecycle             LifecycleStatus @default(ACTIVE)
  version               Int             @default(1)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  productInstallation   ProductInstallation @relation(fields: [productInstallationId], references: [id], onDelete: Cascade)

  @@unique([productInstallationId, capabilityCode])
  @@index([capabilityCode])
}

model ModuleDefinition {
  id          String            @id
  code        String            @unique
  productId   String
  productCode ProductCode
  layerCode   String
  scope       ScopeKind
  realmCode   IdentityRealmCode
  moduleType  ModuleType
  lifecycle   LifecycleStatus   @default(ACTIVE)
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  product     ProductDefinition @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productCode, layerCode, scope])
}

model IdentityRealm {
  id          String            @id
  code        IdentityRealmCode @unique
  name        String
  lifecycle   LifecycleStatus   @default(ACTIVE)
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model RoleDefinition {
  id             String            @id
  code           String
  name           String
  realmCode      IdentityRealmCode
  scope          ScopeKind
  productId      String?
  organizationId String
  lifecycle      LifecycleStatus   @default(ACTIVE)
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        ProductDefinition? @relation(fields: [productId], references: [id], onDelete: Restrict)
  permissions    RolePermission[]

  @@unique([organizationId, realmCode, code])
  @@index([productId])
}

model PermissionDefinition {
  id          String            @id
  code        String            @unique
  name        String
  productId   String?
  layerCode   String
  scope       ScopeKind
  lifecycle   LifecycleStatus   @default(ACTIVE)
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  product     ProductDefinition? @relation(fields: [productId], references: [id], onDelete: Restrict)
  roles       RolePermission[]

  @@index([productId, scope])
}

model RolePermission {
  id           String               @id
  roleId       String
  permissionId String
  lifecycle    LifecycleStatus      @default(ACTIVE)
  createdAt    DateTime             @default(now())
  role         RoleDefinition       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model EffectiveConfigurationSnapshot {
  id                    String          @id
  key                   String
  value                 Json
  valueHash             String
  scope                 ScopeKind
  isCurrent             Boolean         @default(true)
  organizationId        String
  workspaceId           String?
  projectId             String?
  productInstallationId String?
  version               Int             @default(1)
  createdAt             DateTime        @default(now())
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace             Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project               Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  productInstallation   ProductInstallation? @relation(fields: [productInstallationId], references: [id], onDelete: Restrict)

  @@unique([key, organizationId, workspaceId, projectId, productInstallationId, version])
  @@index([organizationId, workspaceId, projectId, productInstallationId, isCurrent])
}

model FeatureFlag {
  id                    String          @id
  code                  String
  enabled               Boolean         @default(false)
  scope                 ScopeKind
  organizationId        String
  workspaceId           String?
  projectId             String?
  productInstallationId String?
  lifecycle             LifecycleStatus @default(ACTIVE)
  version               Int             @default(1)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace             Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project               Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  productInstallation   ProductInstallation? @relation(fields: [productInstallationId], references: [id], onDelete: Restrict)

  @@unique([code, organizationId, workspaceId, projectId, productInstallationId])
  @@index([organizationId, workspaceId, projectId])
}

model AuditRecord {
  id                    String          @id
  organizationId        String
  workspaceId           String?
  projectId             String?
  productInstallationId String?
  actorId               String?
  action                String
  targetType            String
  targetId              String
  sensitive             Boolean         @default(false)
  metadata              Json            @default("{}")
  createdAt             DateTime        @default(now())
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace             Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project               Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  productInstallation   ProductInstallation? @relation(fields: [productInstallationId], references: [id], onDelete: Restrict)
  actor                 UserAccount?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([workspaceId, projectId])
  @@index([action, targetType])
}

model LegacyIdentityMap {
  id                String       @id
  legacySystem      String
  legacyEntityType  String
  legacyEntityId    String
  nextgenEntityType String
  nextgenEntityId   String
  organizationId    String
  workspaceId       String?
  projectId         String?
  mappedAt          DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace         Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project           Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([legacySystem, legacyEntityType, legacyEntityId])
  @@index([nextgenEntityType, nextgenEntityId])
  @@index([organizationId, workspaceId, projectId])
}
